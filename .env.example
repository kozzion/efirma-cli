# Copy to `.env` and fill in your efirma.bg credentials.
# `.env` is git-ignored — never commit real credentials.
#
# Used by `efirma login`. Real environment variables override these.

EFIRMA_EMAIL=you@example.com
EFIRMA_PASSWORD=your-password

# Optional: default company for commands that take --company.
# Accepts a UUID, the URL slug, a bare EIK, or a name fragment.
# EFIRMA_COMPANY=123456789

# Optional: where to store the JWT pair (default: ~/.efirma/session.json)
# EFIRMA_SESSION_FILE=.efirma-session.json
